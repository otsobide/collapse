{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collapse",
  "version": "0.6.0",
  "identifier": "com.cervantic.collapse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Collapse",
        "label": "main",
        "width": 480,
        "height": 520,
        "minWidth": 440,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A small, fast file compressor",
    "longDescription": "Collapse compresses files and folders into 7z, ZIP or tar archives, and extracts them back — with a calm, focused interface.",
    "copyright": "© cervantic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
